---
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[hsl(var(--background)/0.95)] backdrop-blur-sm border-b border-[hsl(var(--border))]">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-1.5 sm:gap-2">
        <img
          src="/plenish-logo.png"
          alt="Plenish Logo"
          class="h-8 w-8 sm:h-10 sm:w-10 object-contain"
          width="40" height="40"
        />
        <span class="text-lg sm:text-xl font-bold text-[hsl(var(--foreground))]">Plenish</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-2">
        <a href="/blog" class="px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">Blog</a>
        <a href="/faq"  class="px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">FAQ</a>
        <a href="https://app.useplenish.com" class="px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">Sign In</a>
        <a href="https://app.useplenish.com" target="_blank" rel="noopener noreferrer"
           class="px-4 py-2 rounded-md text-sm font-medium bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] hover:bg-[hsl(142_76%_30%)] shadow-sm transition-colors">
          Join
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-lg text-[hsl(var(--foreground))] hover:bg-[hsl(var(--secondary))] transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-menu" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <div class="flex flex-col gap-2 pt-2">
        <a href="/blog" class="w-full text-center px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">Blog</a>
        <a href="/faq"  class="w-full text-center px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">FAQ</a>
        <a href="https://app.useplenish.com" class="w-full text-center px-4 py-2 rounded-md text-sm font-medium text-[hsl(var(--foreground))] hover:text-[hsl(var(--primary))] hover:bg-[hsl(var(--secondary))] transition-colors">Sign In</a>
        <a href="https://app.useplenish.com" target="_blank" rel="noopener noreferrer"
           class="w-full text-center px-4 py-2 rounded-md text-sm font-medium bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] hover:bg-[hsl(142_76%_30%)] transition-colors">
          Join
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var iconMenu = document.getElementById('icon-menu');
    var iconClose = document.getElementById('icon-close');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden', !open);
      iconClose.classList.toggle('hidden', open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>
