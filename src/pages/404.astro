---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found | Plenish"
  description="The page you're looking for doesn't exist. Head back to Plenish to track nutrition, plan meals, and support your GLP-1 or fitness journey."
  canonical="https://useplenish.com/404/"
>
  <Header />

  <main id="main-content" tabindex="-1" class="container mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-16 max-w-2xl text-center">
    <p class="text-6xl font-bold text-[hsl(var(--primary))] mb-4">404</p>
    <h1 class="text-3xl md:text-4xl font-bold text-[hsl(var(--foreground))] mb-4">Page not found</h1>
    <p class="text-[hsl(var(--muted-foreground))] leading-relaxed mb-8">
      That page doesn't exist or may have moved. Here are some helpful links to get you back on track.
    </p>
    <nav aria-label="Helpful links" class="flex flex-wrap justify-center gap-4">
      <a href="/" class="inline-flex items-center px-6 py-3 rounded-lg bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] font-semibold hover:opacity-90 transition-opacity">
        Home
      </a>
      <a href="/blog/" class="inline-flex items-center px-6 py-3 rounded-lg border border-[hsl(var(--border))] text-[hsl(var(--foreground))] font-semibold hover:bg-[hsl(var(--muted))] transition-colors">
        Blog
      </a>
      <a href="/faq/" class="inline-flex items-center px-6 py-3 rounded-lg border border-[hsl(var(--border))] text-[hsl(var(--foreground))] font-semibold hover:bg-[hsl(var(--muted))] transition-colors">
        FAQ
      </a>
    </nav>
  </main>

  <Footer />
</BaseLayout>
