  { id: "section-5",  title: "5. PURCHASES AND PAYMENT" },
  { id: "section-6",  title: "6. PROHIBITED ACTIVITIES" },
  { id: "section-7",  title: "7. USER GENERATED CONTRIBUTIONS" },
  { id: "section-8",  title: "8. CONTRIBUTION LICENSE" },
  { id: "section-9",  title: "9. THIRD-PARTY WEBSITES AND CONTENT" },
