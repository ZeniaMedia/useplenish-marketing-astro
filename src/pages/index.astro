---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Plenish — Always Know What to Eat Next"
  description="Plenish tracks meal prep, calories, protein & fiber daily and weekly, building meal plans around fresh ingredients. Designed for GLP-1 journeys, fitness goals, and reducing food waste."
  canonical="https://useplenish.com/"
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-brand-light pt-20 pb-24 px-4 sm:px-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 leading-tight">
          Always Know What to Eat Next
        </h1>
        <p class="mt-5 text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Plenish tracks meal prep, calories, protein &amp; fiber daily and weekly, building meal plans around fresh ingredients. Designed for GLP-1 journeys, fitness goals, and reducing food waste.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="https://app.useplenish.com"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand text-white font-medium hover:bg-brand-dark transition-colors text-base"
          >
            Get Started
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-medium hover:border-brand hover:text-brand transition-colors text-base"
          >
            See How It Works
          </a>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-20 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Everything You Need to Eat Smarter</h2>
          <p class="mt-3 text-gray-500 text-lg">Inventory, nutrition, and meal planning — all in one place.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              icon: '📦',
              title: 'Smart Inventory Tracking',
              body: 'Keep fridge, freezer, pantry, and snacks organized in one place. Know exactly what you have at a glance.',
            },
            {
              icon: '📅',
              title: 'Auto-Generated Meal Plans',
              body: 'Personalized weekly meal plans built around prepped items — no more guessing what to eat next.',
            },
            {
              icon: '🎯',
              title: 'Calorie, Protein & Fiber Tracking',
              body: 'Hit daily and weekly goals — because consistency beats perfection. Full macro tracking (carbs and fat) available when you want it.',
            },
            {
              icon: '🤖',
              title: 'AI-Assisted Nutrition Estimates',
              body: "Home cooked dishes, takeout, and restaurant meals don't always come with nutrition labels. Let AI fill in the numbers for you.",
            },
            {
              icon: '🍎',
              title: 'Snacks & Quick Adds',
              body: 'Log snacks straight from inventory, or add one-off foods on the fly without cluttering meal prep.',
            },
            {
              icon: '♻️',
              title: 'Never Waste Food',
              body: "Freshness-aware planning prioritizes what's closest to expiring, so you eat what you have before it goes bad.",
            },
          ].map((f) => (
            <div class="bg-white border border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
              <div class="text-3xl mb-3">{f.icon}</div>
              <h3 class="font-semibold text-gray-900 text-lg mb-2">{f.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Built for you -->
    <section class="bg-gray-50 py-20 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Built for the Way You Actually Eat</h2>
          <p class="mt-3 text-gray-500 text-lg max-w-xl mx-auto">
            Whether managing appetite, chasing performance, or reducing food waste — Plenish meets you where you are.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {[
            {
              label: 'GLP-1 Journeys',
              icon: '💊',
              body: 'Appetite varies day to day. Weekly goals plus focus on protein and fiber keep nutrition on track even on low-appetite days.',
            },
            {
              label: 'Fitness Goals',
              icon: '🏋️',
              body: 'Hit protein targets, manage calories, and plan meals around training — without spreadsheets or guesswork.',
            },
            {
              label: 'Reducing Food Waste',
              icon: '🥦',
              body: "Freshness-first plans use what you already have, so groceries don't end up in the trash.",
            },
          ].map((u) => (
            <div class="bg-white rounded-xl p-7 border border-gray-100 shadow-sm text-center">
              <div class="text-4xl mb-4">{u.icon}</div>
              <h3 class="font-semibold text-gray-900 text-lg mb-2">Built for {u.label}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{u.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-20 px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How It Works</h2>
          <p class="mt-3 text-gray-500 text-lg">Get started in minutes with three simple steps</p>
        </div>

        <ol class="space-y-10">
          {[
            {
              step: '1',
              title: 'Add your meal prep, snacks, and pantry items',
              body: "Log what you've prepped or bought — fridge, freezer, pantry, and snacks. AI-assisted nutrition estimates fill in the gaps for home-cooked, takeout, and restaurant meals.",
            },
            {
              step: '2',
              title: 'Set your nutrition goals and preferences',
              body: 'Pick daily and weekly targets for calories, protein, and fiber (carbs and fat too, if you want them). Tell Plenish how you like to eat.',
            },
            {
              step: '3',
              title: 'Get a personalized 1–4 week meal plan',
              body: "Plenish builds your plan around what's freshest and what hits your goals — so you always know what to eat next.",
            },
          ].map((s) => (
            <li class="flex gap-5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand text-white flex items-center justify-center font-bold text-lg">
                {s.step}
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-lg">{s.title}</h3>
                <p class="mt-1 text-gray-500 leading-relaxed">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Planning timeline -->
    <section class="bg-brand-light py-20 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Planning That Works on Your Timeline</h2>
          <p class="mt-3 text-gray-500 text-lg max-w-xl mx-auto">
            Most meal planners assume your week looks like everyone else's. Plenish lets you plan the way you actually live.
          </p>
        </div>

        <div class="grid sm:grid-cols-3 gap-6">
          {[
            {
              title: 'Plan 1–4 weeks at a time',
              body: 'Pick the planning horizon that fits your life. One week if things change fast, up to four weeks if you batch cook and freeze.',
            },
            {
              title: "Plans built around what's already prepped",
              body: "Plenish starts with what's in your fridge, freezer, and pantry — so your meal plan reflects reality, not a pristine grocery list.",
            },
            {
              title: 'Track progress over time',
              body: 'Meal plan history and weekly nutrition trends make it easy to see how you\'re actually doing — not just how today went.',
            },
          ].map((p) => (
            <div class="bg-white rounded-xl p-6 border border-green-100 shadow-sm">
              <h3 class="font-semibold text-gray-900 text-base mb-2">{p.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24 px-4 sm:px-6 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Always Know What to Eat Next</h2>
        <p class="mt-4 text-lg text-gray-500 leading-relaxed">
          Track your inventory, hit your nutrition goals, and get a meal plan built around what you already have. Free to start.
        </p>
        <a
          href="https://app.useplenish.com"
          class="mt-8 inline-flex items-center justify-center px-8 py-4 rounded-lg bg-brand text-white font-medium hover:bg-brand-dark transition-colors text-lg"
        >
          Get Started
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
