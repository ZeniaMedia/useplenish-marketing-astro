---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Blog — Plenish"
  description="Tips, guides, and insights on meal prep, nutrition tracking, GLP-1 journeys, and reducing food waste from the Plenish team."
  canonical="https://useplenish.com/blog/"
>
  <Header />

  <main class="container mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold text-[hsl(var(--foreground))] mb-3">Blog</h1>
    <p class="text-lg text-[hsl(var(--muted-foreground))] mb-12">
      Tips, guides, and insights on meal prep, nutrition, and reducing food waste.
    </p>

    <div class="border-2 border-dashed border-[hsl(var(--border))] rounded-2xl p-12 text-center">
      <p class="text-3xl mb-3">✍️</p>
      <p class="font-semibold text-[hsl(var(--foreground))]">Posts coming soon</p>
      <p class="text-sm mt-1 text-[hsl(var(--muted-foreground))]">Check back for articles on meal prep, GLP-1 nutrition, fitness goals, and more.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>
