---
---

<footer class="py-12 md:py-16 bg-[hsl(var(--background))] border-t border-[hsl(var(--border))]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">

      <!-- Logo -->
      <div class="flex flex-col items-center md:items-start gap-2">
        <img
          src="/plenish-full-logo.png"
          alt="Plenish"
          class="h-8 w-auto"
          height="32"
        />
      </div>

      <!-- Links -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 flex-wrap justify-center">
        <a href="mailto:support@useplenish.com"  class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">support@useplenish.com</a>
        <a href="mailto:feedback@useplenish.com" class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">feedback@useplenish.com</a>
        <a href="/blog"    class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">Blog</a>
        <a href="/faq"           class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">FAQ</a>
        <a href="/release-notes" class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">Release Notes</a>
        <a href="/privacy"       class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">Privacy Policy</a>
        <a href="/terms"   class="text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--primary))] transition-colors">Terms &amp; Conditions</a>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-[hsl(var(--border))] text-center">
      <p class="text-sm text-[hsl(var(--muted-foreground))]">&copy; 2026 Plenish. All rights reserved.</p>
    </div>
  </div>
</footer>
