---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Exact Lucide icon paths sourced from lucide-icons/lucide @ 0.462.0
// Features section: Package, Calendar, Target, Wand2 (wand-sparkles), Cookie, Leaf
// BuiltFor section: Activity, Dumbbell, Sprout
// HowItWorks section: ClipboardList, Target, Sparkles
// Planning section: CalendarRange, ChefHat, LineChart (chart-line)

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Plenish",
  "url": "https://useplenish.com/",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "iOS, Android, Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Plenish tracks your meal prep, calories, protein & fiber — daily and weekly — and builds your meal plan around what's fresh. Designed for GLP-1 journeys, fitness goals, and anyone who hates wasting food.",
  "publisher": {
    "@type": "Organization",
    "name": "Plenish",
    "url": "https://useplenish.com/"
  }
};
---

<BaseLayout
  title="Plenish — Always Know What to Eat Next"
  description="Plenish tracks your meal prep, calories, protein & fiber — daily and weekly — and builds your meal plan around what's fresh. Designed for GLP-1 journeys, fitness goals, and anyone who hates wasting food."
  canonical="https://useplenish.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} slot="head" />
  <Header />

  <main>

    <!-- =================== HERO =================== -->
    <section class="relative min-h-screen flex items-start justify-center overflow-hidden pt-24 md:pt-32"
             style="background: linear-gradient(135deg, hsl(142 76% 36%) 0%, hsl(142 60% 45%) 50%, hsl(142 50% 55%) 100%);">

      <!-- Decorative blobs -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/4 left-10 w-64 h-64 rounded-full blur-3xl" style="background: rgba(255,255,255,0.05);"></div>
        <div class="absolute bottom-1/4 right-10 w-96 h-96 rounded-full blur-3xl" style="background: rgba(255,255,255,0.05);"></div>
      </div>

      <div class="container relative mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">

          <!-- Text -->
          <div class="text-center lg:text-left pt-8 md:pt-12">
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight" style="color: white;">
              Always Know What to Eat Next
            </h1>
            <p class="mt-6 text-lg sm:text-xl max-w-xl mx-auto lg:mx-0" style="color: rgba(255,255,255,0.9);">
              Plenish tracks your meal prep, calories, protein &amp; fiber — daily and weekly — and builds your meal plan around what's fresh. Designed for GLP-1 journeys, fitness goals, and anyone who hates wasting food.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="https://app.useplenish.com" target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-[var(--radius)] text-lg font-semibold shadow-lg transition-colors"
                 style="background: white; color: hsl(142 76% 36%);"
                 onmouseover="this.style.background='rgba(255,255,255,0.9)'" onmouseout="this.style.background='white'">
                Get Started
                <!-- ArrowRight -->
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
              <a href="#how-it-works"
                 class="inline-flex items-center justify-center px-8 py-4 rounded-[var(--radius)] text-lg font-semibold transition-colors"
                 style="border: 2px solid rgba(255,255,255,0.4); color: white; background: transparent;"
                 onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'">
                See How It Works
              </a>
            </div>
          </div>

          <!-- Phone Mockup -->
          <div class="flex justify-center lg:justify-end">
            <div class="relative">
              <!-- Phone frame -->
              <div class="relative rounded-[2.5rem] p-2 shadow-2xl" style="background: hsl(142 71% 15%); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);">
                <!-- Screen -->
                <div class="relative overflow-hidden rounded-[2rem]" style="background: white;">
                  <img
                    src="/dashboard-screenshot.png"
                    alt="Plenish App Dashboard — Track your meal prep inventory"
                    class="w-48 sm:w-56 md:w-64 h-auto object-cover object-top"
                    width="256"
                    loading="eager"
                  />
                </div>
                <!-- Dynamic island notch -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 h-5 w-20 rounded-full" style="background: hsl(142 71% 15%);"></div>
              </div>
              <!-- Glow -->
              <div class="absolute -inset-4 rounded-[3.5rem] blur-2xl -z-10" style="background: rgba(255,255,255,0.2);"></div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =================== FEATURES =================== -->
    <!-- Icons: Package, Calendar, Target, Wand2, Cookie, Leaf -->
    <section class="py-20 md:py-28 bg-[hsl(var(--background))]">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(var(--foreground))]">Everything You Need to Eat Smarter</h2>
          <p class="mt-4 text-lg text-[hsl(var(--muted-foreground))]">Inventory, nutrition, and meal planning — all in one place.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

          <!-- Package -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
                <path d="M12 22V12"/>
                <path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/>
                <path d="m7.5 4.27 9 5.15"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Smart Inventory Tracking</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Keep your fridge, freezer, pantry, and snacks organized in one place. Know exactly what you have at a glance.</p>
          </div>

          <!-- Calendar -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v4"/>
                <path d="M16 2v4"/>
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M3 10h18"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Auto-Generated Meal Plans</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Personalized weekly meal plans built around what you've already prepped — no more guessing what to eat next.</p>
          </div>

          <!-- Target -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Calorie, Protein &amp; Fiber Tracking</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Hit daily and weekly goals — because consistency beats perfection. Full macro tracking (carbs and fat) available when you want it.</p>
          </div>

          <!-- Wand2 (wand-sparkles) -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/>
                <path d="m14 7 3 3"/>
                <path d="M5 6v4"/>
                <path d="M19 14v4"/>
                <path d="M10 2v2"/>
                <path d="M7 8H3"/>
                <path d="M21 16h-4"/>
                <path d="M11 3H9"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">AI-Assisted Nutrition Estimates</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Home cooked dishes, takeout, and restaurant meals don't always come with nutrition labels. Let AI fill in the numbers for you.</p>
          </div>

          <!-- Cookie -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                <path d="M8.5 8.5v.01"/>
                <path d="M16 15.5v.01"/>
                <path d="M12 12v.01"/>
                <path d="M11 17v.01"/>
                <path d="M7 14v.01"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Snacks &amp; Quick Adds</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Log snacks straight from your inventory, or add one-off foods on the fly without cluttering your meal prep.</p>
          </div>

          <!-- Leaf -->
          <div class="group relative p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6 transition-colors duration-300 group-hover:[background:hsl(var(--primary))] group-hover:[color:hsl(var(--primary-foreground))]"
                 style="background: hsl(142 76% 36% / 0.1); color: hsl(var(--primary));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Never Waste Food</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Freshness-aware planning prioritizes what's closest to expiring, so you eat what you have before it goes bad.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- =================== BUILT FOR =================== -->
    <!-- Icons: Activity, Dumbbell, Sprout -->
    <section class="py-20 md:py-28 bg-[hsl(var(--background))]">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(var(--foreground))]">Built for the Way You Actually Eat</h2>
          <p class="mt-4 text-lg text-[hsl(var(--muted-foreground))]">Whether you're managing appetite, chasing performance, or just sick of throwing food away — Plenish meets you where you are.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">

          <!-- Activity (GLP-1) -->
          <div class="p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6"
                 style="background: hsl(32 95% 44% / 0.15); color: hsl(var(--accent));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Built for GLP-1 journeys</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Appetite varies day to day. Weekly goals plus a focus on protein and fiber keep your nutrition on track even on low-appetite days.</p>
          </div>

          <!-- Dumbbell (Fitness) -->
          <div class="p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6"
                 style="background: hsl(32 95% 44% / 0.15); color: hsl(var(--accent));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.4 14.4 9.6 9.6"/>
                <path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/>
                <path d="m21.5 21.5-1.4-1.4"/>
                <path d="M3.9 3.9 2.5 2.5"/>
                <path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Built for fitness goals</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Hit your protein targets, manage calories, and plan meals around your training — without spreadsheets or guesswork.</p>
          </div>

          <!-- Sprout (Food waste) -->
          <div class="p-8 rounded-2xl bg-[hsl(var(--card))] border border-[hsl(var(--border))] hover:border-[hsl(142_76%_36%/0.3)] hover:shadow-lg transition-all duration-300">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl mb-6"
                 style="background: hsl(32 95% 44% / 0.15); color: hsl(var(--accent));">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 20h10"/>
                <path d="M10 20c5.5-2.5.8-6.4 3-10"/>
                <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/>
                <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--card-foreground))] mb-3">Built for anyone who hates wasting food</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed">Freshness-first plans use what you already have, so groceries don't end up in the trash.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- =================== HOW IT WORKS =================== -->
    <!-- Icons: ClipboardList, Target, Sparkles -->
    <section id="how-it-works" class="py-20 md:py-28" style="background: hsl(142 40% 96% / 0.5);">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-[hsl(var(--foreground))]">How It Works</h2>
          <p class="mt-4 text-lg text-[hsl(var(--muted-foreground))]">Get started in minutes with three simple steps</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-12 max-w-5xl mx-auto">

          <!-- Step 1: ClipboardList -->
          <div class="relative text-center">
            <div class="hidden md:block absolute top-12 h-0.5 bg-[hsl(var(--border))]" style="left: 60%; width: 80%;"></div>
            <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full mb-6 shadow-lg"
                 style="background: hsl(var(--primary)); color: white;">
              <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                <path d="M12 11h4"/>
                <path d="M12 16h4"/>
                <path d="M8 11h.01"/>
                <path d="M8 16h.01"/>
              </svg>
              <span class="absolute -top-2 -right-2 w-8 h-8 rounded-full text-sm font-bold flex items-center justify-center shadow-md"
                    style="background: hsl(var(--accent)); color: white;">1</span>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Add your meal prep, snacks, and pantry items</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed max-w-xs mx-auto">Log what you've prepped or bought — fridge, freezer, pantry, and snacks. AI-assisted nutrition estimates fill in the gaps for home-cooked, takeout, and restaurant meals.</p>
          </div>

          <!-- Step 2: Target -->
          <div class="relative text-center">
            <div class="hidden md:block absolute top-12 h-0.5 bg-[hsl(var(--border))]" style="left: 60%; width: 80%;"></div>
            <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full mb-6 shadow-lg"
                 style="background: hsl(var(--primary)); color: white;">
              <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
              <span class="absolute -top-2 -right-2 w-8 h-8 rounded-full text-sm font-bold flex items-center justify-center shadow-md"
                    style="background: hsl(var(--accent)); color: white;">2</span>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Set your nutrition goals and preferences</h3>
            <p class="text-[hsl(var(--muted-foreground))] leading-relaxed max-w-xs mx-auto">Pick daily and weekly targets for calories, protein, and fiber (carbs and fat too, if you want them). Tell Plenish how you like to eat.</p>
          </div>

          <!-- Step 3: Sparkles -->
          <div class="relative text-center">
            <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full mb-6 shadow-lg"
                 style="background: hsl(var(--primary)); color: white;">
              <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                <path d="M20 3v4"/>
                <path d="M22 5h-4"/>
                <path d="M4 17v2"/>
                <path d="M5 18H3"/>
              </svg>
              <span class="absolute -top-2 -right-2 w-8 h-8 rounded-full text-sm font-bold flex items-center justify-center shadow-md"
                    style="background: hsl(var(--accent)); color: white;">3</span>
            </div>
            <h3 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Get a personalized 1–4 week meal plan</h3>
