---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Privacy Policy — Plenish"
  description="Plenish privacy policy — how we collect, use, and protect your personal data."
  canonical="https://useplenish.com/privacy/"
>
  <Header />

  <main class="container mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 max-w-3xl">
    <h1 class="text-4xl font-bold text-[hsl(var(--foreground))] mb-2">Privacy Policy</h1>
    <p class="text-sm text-[hsl(var(--muted-foreground))] mb-12">Last Updated: May 05, 2026</p>

    <div class="space-y-8 text-[hsl(var(--muted-foreground))] leading-relaxed">

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Information We Collect</h2>
        <p>
          Plenish gathers personal details voluntarily provided during registration, including names, email addresses, passwords, and usernames. The service also automatically collects technical data like IP addresses, device information, and usage patterns when you access the application.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">How We Use Your Information</h2>
        <p>
          We process your information to facilitate account creation and authentication, respond to user inquiries, deliver our services, and send marketing communications where you have opted in. We employ AI-powered features to generate personalized meal plans based on your inventory and preferences.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Data Sharing &amp; Security</h2>
        <p>
          Plenish may share information during business transfers. We do not collect any information from third parties and do not sell your personal data for advertising purposes. While we implement industry-standard security measures, no electronic transmission over the Internet can be guaranteed to be 100% secure.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Your Rights</h2>
        <p>
          Residents of certain US states and EEA regions can request access, correction, or deletion of their data by contacting <a href="mailto:support@useplenish.com" class="text-[hsl(var(--primary))] hover:underline">support@useplenish.com</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Children's Privacy</h2>
        <p>
          We do not knowingly collect data from or market to children under 18 years of age. If you believe a child under 18 has provided us personal information, please contact us at <a href="mailto:support@useplenish.com" class="text-[hsl(var(--primary))] hover:underline">support@useplenish.com</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Policy Updates</h2>
        <p>
          We reserve the right to update this privacy notice periodically to maintain legal compliance. Changes will be indicated by a revised date at the top of this page.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-[hsl(var(--foreground))] mb-3">Contact Us</h2>
        <p>
          If you have questions about this Privacy Policy, please contact us at:
          <a href="mailto:support@useplenish.com" class="text-[hsl(var(--primary))] hover:underline">support@useplenish.com</a>
        </p>
        <address class="not-italic mt-2">
          Plenish<br />
          24-41 31st St, #1088<br />
          Astoria, NY 11102<br />
          United States
        </address>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>
