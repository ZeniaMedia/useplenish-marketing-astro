        <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full blur-3xl" style="background: rgba(255,255,255,0.05);"></div>
        <div class="absolute bottom-0 right-1/4 w-64 h-64 rounded-full blur-3xl" style="background: rgba(255,255,255,0.05);"></div>
