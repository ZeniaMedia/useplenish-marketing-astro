---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getFeaturedPost, publishedPosts, formatDate, getPostUrl } from '../../data/posts';

const DESCRIPTION = "Nutrition tracking and meal prep guides for GLP-1 journeys, ADHD nutrition, and anyone who hates wasting food — from the team building Plenish.";

const featured = getFeaturedPost();
const rest = publishedPosts.filter((p) => p.slug !== featured?.slug);

const canonical = "https://useplenish.com/blog/";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${new URL(canonical).origin}/` },
    { "@type": "ListItem", "position": 2, "name": "Blog" },
  ],
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Plenish Blog",
  "url": canonical,
  "description": DESCRIPTION,
  "numberOfItems": publishedPosts.length,
  "itemListElement": [...publishedPosts]
    .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
    .map((post, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": post.title,
      "url": getPostUrl(post),
    })),
};

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Plenish Blog",
  "url": canonical,
  "description": DESCRIPTION,
  "datePublished": "2026",
  "dateModified": new Date().toISOString().slice(0, 10),
  "isPartOf": { "@id": `${new URL(canonical).origin}/#website` },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "https://useplenish.com/og-image.png",
  },
  "breadcrumb": { "@id": `${canonical}#breadcrumb` },
  "inLanguage": "en-US",
};
---

{/*
  [AI/DEVELOPER INSTRUCTION] After making any changes to metadata in this file,
  include a reminder in your response to update the Plenish Page Metadata DB
  in Notion before closing this session.
*/}
<BaseLayout
  title="Plenish Blog"
  description={DESCRIPTION}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} slot="head" />
  <Header />

  <main class="container mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 max-w-6xl">
    <div class="max-w-3xl mb-10">
      <h1 class="text-4xl md:text-5xl font-bold text-[hsl(var(--foreground))] mb-4">The Plenish Blog</h1>
      <p class="text-lg text-[hsl(var(--muted-foreground))]">{DESCRIPTION}</p>
    </div>

    {publishedPosts.length === 0 ? (
      <p class="text-[hsl(var(--muted-foreground))] py-12 text-center">No posts yet. Check back soon.</p>
    ) : (
      <>
        {featured && (
          <div class="mb-12">
            <article class="group grid md:grid-cols-2 gap-8 items-center rounded-3xl overflow-hidden border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-6 md:p-8">
              <a href={`/blog/${featured.slug}`} class="block aspect-[16/10] overflow-hidden rounded-2xl bg-[hsl(var(--secondary))]">
                <img
                  src={featured.heroImage}
                  alt={featured.heroImageAlt}
                  loading="eager"
                  class={`w-full h-full ${featured.heroFit === "contain" ? "object-contain" : "object-cover group-hover:scale-105 transition-transform duration-500"}`}
                />
              </a>
              <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-[hsl(var(--accent))]">Featured</span>
                  <a href={`/blog/category/${featured.categorySlug}`} class="text-xs font-semibold uppercase tracking-wide text-[hsl(var(--primary))] hover:underline">
                    {featured.category}
                  </a>
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-[hsl(var(--foreground))] leading-tight">
                  <a href={`/blog/${featured.slug}`} class="hover:text-[hsl(var(--primary))] transition-colors">
                    {featured.title}
                  </a>
                </h2>
                <p class="text-base text-[hsl(var(--muted-foreground))]">{featured.description}</p>
                <div class="text-sm text-[hsl(var(--muted-foreground))]">
                  <time datetime={featured.publishedAt}>{formatDate(featured.publishedAt)}</time>
                  <span aria-hidden> · </span>
                  {featured.authorName}
                </div>
              </div>
            </article>
          </div>
        )}

        {rest.length > 0 && (
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map((p) => (
              <article class="group flex flex-col rounded-2xl overflow-hidden border border-[hsl(var(--border))] bg-[hsl(var(--card))] hover:shadow-lg transition-shadow">
                <a href={`/blog/${p.slug}`} class="block aspect-[16/9] overflow-hidden bg-[hsl(var(--secondary))]">
                  <img
                    src={p.heroImage}
                    alt={p.heroImageAlt}
                    loading="lazy"
                    class={`w-full h-full ${p.heroFit === "contain" ? "object-contain" : "object-cover group-hover:scale-105 transition-transform duration-500"}`}
                  />
                </a>
                <div class="p-6 flex flex-col gap-3 flex-1">
                  <a href={`/blog/category/${p.categorySlug}`} class="text-xs font-semibold uppercase tracking-wide text-[hsl(var(--primary))] hover:underline w-fit">
                    {p.category}
                  </a>
                  <h3 class="text-xl font-bold text-[hsl(var(--foreground))] leading-snug">
                    <a href={`/blog/${p.slug}`} class="hover:text-[hsl(var(--primary))] transition-colors">{p.title}</a>
                  </h3>
                  <p class="text-sm text-[hsl(var(--muted-foreground))] line-clamp-3 flex-1">{p.description}</p>
                  <div class="text-xs text-[hsl(var(--muted-foreground))] pt-2">
                    <time datetime={p.publishedAt}>{formatDate(p.publishedAt, { year: "numeric", month: "short", day: "numeric" })}</time>
                    <span aria-hidden> · </span>
                    {p.authorName}
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </>
    )}
  </main>

  <Footer />
</BaseLayout>
