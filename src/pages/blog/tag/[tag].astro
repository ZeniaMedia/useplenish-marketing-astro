---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAllTags, getPostsByTag, formatDate } from '../../../data/posts';

export function getStaticPaths() {
  const tags = getAllTags();
  return tags.map((tag) => ({
    params: { tag: tag.replace(/\s+/g, "-") },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const matchedPosts = getPostsByTag(tag);

const title = `Posts tagged ${tag} — Plenish Blog`;
const description = `All Plenish blog posts tagged with ${tag}.`;
const tagSlug = tag.replace(/\s+/g, "-");
const canonical = `https://useplenish.com/blog/tag/${tagSlug}/`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${new URL(canonical).origin}/` },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${new URL(canonical).origin}/blog/` },
    { "@type": "ListItem", "position": 3, "name": `#${tag}` },
  ],
};

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `#${tag} | Plenish Blog`,
  "url": canonical,
  "description": `Plenish blog posts tagged #${tag}.`,
  "datePublished": "2026",
  "dateModified": new Date().toISOString().slice(0, 10),
  "isPartOf": { "@id": `${new URL(canonical).origin}/#website` },
  "primaryImageOfPage": { "@type": "ImageObject", "url": "https://useplenish.com/og-image.png" },
  "breadcrumb": { "@id": `${canonical}#breadcrumb` },
  "inLanguage": "en-US",
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} slot="head" />
  <Header />

  <main class="container mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 max-w-6xl">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-[hsl(var(--muted-foreground))]">
      <a href="/" class="hover:text-[hsl(var(--primary))]">Home</a>
      <span aria-hidden> / </span>
      <a href="/blog" class="hover:text-[hsl(var(--primary))]">Blog</a>
      <span aria-hidden> / </span>
      <span>#{tag}</span>
    </nav>

    <div class="max-w-3xl mb-10">
      <p class="text-sm font-semibold uppercase tracking-wide text-[hsl(var(--primary))] mb-2">Tag</p>
      <h1 class="text-4xl md:text-5xl font-bold text-[hsl(var(--foreground))] mb-4">#{tag}</h1>
      <p class="text-lg text-[hsl(var(--muted-foreground))]">
        {matchedPosts.length} post{matchedPosts.length !== 1 ? "s" : ""} tagged with this topic
      </p>
    </div>

    {matchedPosts.length === 0 ? (
      <p class="text-[hsl(var(--muted-foreground))] py-12 text-center">No posts found for this tag.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {matchedPosts.map((p) => (
          <article class="group flex flex-col rounded-2xl overflow-hidden border border-[hsl(var(--border))] bg-[hsl(var(--card))] hover:shadow-lg transition-shadow">
            <a href={`/blog/${p.slug}`} class="block aspect-[16/9] overflow-hidden bg-[hsl(var(--secondary))]">
              <img
                src={p.heroImage}
                alt={p.heroImageAlt}
                loading="lazy"
                class={`w-full h-full ${p.heroFit === "contain" ? "object-contain" : "object-cover group-hover:scale-105 transition-transform duration-500"}`}
              />
            </a>
            <div class="p-6 flex flex-col gap-3 flex-1">
              <a
                href={`/blog/category/${p.categorySlug}`}
                class="text-xs font-semibold uppercase tracking-wide text-[hsl(var(--primary))] hover:underline w-fit"
              >
                {p.category}
              </a>
              <h2 class="text-xl font-bold text-[hsl(var(--foreground))] leading-snug">
                <a href={`/blog/${p.slug}`} class="hover:text-[hsl(var(--primary))] transition-colors">
                  {p.title}
                </a>
              </h2>
              <p class="text-sm text-[hsl(var(--muted-foreground))] line-clamp-3 flex-1">{p.description}</p>
              <div class="text-xs text-[hsl(var(--muted-foreground))] pt-2">
                <time datetime={p.publishedAt}>{formatDate(p.publishedAt, { year: "numeric", month: "short", day: "numeric" })}</time>
                <span aria-hidden> · </span>
                {p.authorName}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-block text-sm font-semibold text-[hsl(var(--primary))] hover:underline">
        ← Back to all posts
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
